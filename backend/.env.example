# Copy to backend/.env and fill in your own values. Never commit .env.
PORT=5001

# Local MongoDB or your own MongoDB Atlas connection string
MONGO_URL=mongodb://127.0.0.1:27017/tracknow

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Code a new security guard must enter to create a security account
SECURITY_SIGNUP_CODE=change-me

# Comma-separated list of frontend origins allowed by CORS / Socket.IO
CORS_ORIGINS=http://localhost:3000
